# Save.az Telegram Downloader Bot - Environment Configuration Example
# Do not commit real secrets to version control.

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Save.az Backend API URL (Main media resolver & processing backend)
# Example: https://save.az
SAVE_API_URL="https://save.az"

# Comma-separated list of Telegram User IDs who have Admin permissions
# Example: 123456789,987654321
ADMIN_TELEGRAM_IDS="123456789"

# Telegram Bot Web Admin Panel Authentication (/bot-admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourSecurePasswordHere!"
# Optional: precomputed scrypt password hash (salt:hexkey)
ADMIN_PASSWORD_HASH=""

# Database connection (SQLite file path or PostgreSQL URL)
# SQLite default: ./data/saveaz.db
# PostgreSQL example: postgresql://user:password@localhost:5432/saveaz
DATABASE_URL="./data/saveaz.db"

# Optional Gemini API Key for smart customer support & FAQ assistance
GEMINI_API_KEY=""

# Server & Runtime Configuration
NODE_ENV="production"
PORT=3000

# Bot Execution Mode: 'polling' for local development, 'webhook' for production VPS/Cloud Run
BOT_MODE="polling"

# Webhook configuration (Required if BOT_MODE=webhook)
WEBHOOK_DOMAIN="https://bot.save.az"
WEBHOOK_PATH="/telegram/webhook"
WEBHOOK_SECRET="super-secret-random-token"

# Safety and limits
MAX_DOWNLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=15
MAX_PLAYLIST_ITEMS=20
DOWNLOAD_TIMEOUT_SECONDS=120
